{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/main.ts",
    "src/preload.ts",
    "src/config/**/*",
    "src/database/**/*",
    "src/services/**/*",
    "src/types/**/*",
    "src/utils/**/*"
  ],
  "exclude": [
    "src/pages/**/*",
    "src/renderer/**/*"
  ]
}
